<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="stylesheet" href="/css/style.css">
  {% if gallery %}<link rel="stylesheet" href="/vendor/photoswipe.css">{% endif %}
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}</a>
    <nav>
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a>
      <a href="/blog/"{% if "/blog/" in page.url %} aria-current="page"{% endif %}>Journal</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <span>© {{ site.year }} {{ site.title }}</span>
    <a href="https://instagram.com/{{ site.instagram }}">Instagram</a>
  </footer>
  {% if gallery %}<script type="module" src="/js/gallery.js"></script>{% endif %}
</body>
</html>
