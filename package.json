{
  "name": "maincoon-blog",
  "version": "1.0.0",
  "description": "The Maine Coon Journal — a photo journal built with Eleventy",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run clean && eleventy",
    "clean": "rm -rf _site",
    "new": "node scripts/new-entry.js",
    "deploy": "npm run build && netlify deploy --prod --no-build --dir=_site --site=mainecoonnz"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "luxon": "^3.7.2",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.4"
  },
  "private": true,
  "devDependencies": {
    "netlify-cli": "^27.8.1"
  }
}
